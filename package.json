{
  "name": "git-workspace-pro",
  "displayName": "Git Workspace Pro",
  "description": "A multi-repository Git workspace manager for VS Code.",
  "version": "0.0.1",
  "author": "Ninh Ngọc Tuấn",
  "publisher": "internal",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Source Control",
    "Other"
  ],
  "icon": "media/logo.png",
  "main": "./dist/extension/activate.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitWorkspacePro",
          "title": "Git Workspace Pro",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "gitWorkspacePro": [
        {
          "id": "gitWorkspacePro.repositories",
          "name": "Repositories"
        }
      ]
    },
    "commands": [
      {
        "command": "gitWorkspacePro.refreshRepositories",
        "title": "Git Workspace Pro: Refresh Repositories",
        "icon": "$(refresh)"
      },
      {
        "command": "gitWorkspacePro.openChangedFile",
        "title": "Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitWorkspacePro.stageFile",
        "title": "Stage File",
        "icon": "$(add)"
      },
      {
        "command": "gitWorkspacePro.unstageFile",
        "title": "Unstage File",
        "icon": "$(remove)"
      },
      {
        "command": "gitWorkspacePro.openDiff",
        "title": "Open Diff",
        "icon": "$(diff)"
      },
      {
        "command": "gitWorkspacePro.discardFile",
        "title": "Discard File",
        "icon": "$(discard)"
      },
      {
        "command": "gitWorkspacePro.stageAll",
        "title": "Stage All",
        "icon": "$(add)"
      },
      {
        "command": "gitWorkspacePro.unstageAll",
        "title": "Unstage All",
        "icon": "$(remove)"
      },
      {
        "command": "gitWorkspacePro.restoreAll",
        "title": "Restore All",
        "icon": "$(discard)"
      },
      {
        "command": "gitWorkspacePro.commit",
        "title": "Commit",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitWorkspacePro.fetch",
        "title": "Fetch",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitWorkspacePro.pull",
        "title": "Pull",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitWorkspacePro.pullBranch",
        "title": "Pull From Branch",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitWorkspacePro.push",
        "title": "Push",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitWorkspacePro.checkoutBranch",
        "title": "Checkout Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitWorkspacePro.createBranch",
        "title": "Create Branch",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "gitWorkspacePro.deleteBranch",
        "title": "Delete Branch",
        "icon": "$(trash)"
      },
      {
        "command": "gitWorkspacePro.mergeBranch",
        "title": "Merge Branch",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitWorkspacePro.rebaseBranch",
        "title": "Rebase Onto Branch",
        "icon": "$(repo-force-push)"
      },
      {
        "command": "gitWorkspacePro.stashPush",
        "title": "Stash Push",
        "icon": "$(archive)"
      },
      {
        "command": "gitWorkspacePro.stashPop",
        "title": "Stash Pop",
        "icon": "$(folder-opened)"
      },
      {
        "command": "gitWorkspacePro.showRepositoryActions",
        "title": "Repository Actions",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "gitWorkspacePro.openChangedFile",
          "when": "view == gitWorkspacePro.repositories && viewItem =~ /changedFile/",
          "group": "inline@1"
        },
        {
          "command": "gitWorkspacePro.openDiff",
          "when": "view == gitWorkspacePro.repositories && viewItem =~ /changedFile/",
          "group": "inline@2"
        },
        {
          "command": "gitWorkspacePro.stageFile",
          "when": "view == gitWorkspacePro.repositories && (viewItem == changedFile.unstaged || viewItem == changedFile.untracked || viewItem == changedFile.conflicted)",
          "group": "inline@3"
        },
        {
          "command": "gitWorkspacePro.unstageFile",
          "when": "view == gitWorkspacePro.repositories && viewItem == changedFile.staged",
          "group": "inline@4"
        },
        {
          "command": "gitWorkspacePro.discardFile",
          "when": "view == gitWorkspacePro.repositories && (viewItem == changedFile.unstaged || viewItem == changedFile.untracked)",
          "group": "inline@5"
        },
        {
          "command": "gitWorkspacePro.refreshRepositories",
          "when": "view == gitWorkspacePro.repositories && viewItem == repository",
          "group": "inline@4"
        },
        {
          "command": "gitWorkspacePro.showRepositoryActions",
          "when": "view == gitWorkspacePro.repositories && viewItem == repository",
          "group": "navigation@1"
        },
        {
          "command": "gitWorkspacePro.restoreAll",
          "when": "view == gitWorkspacePro.repositories && viewItem == repository",
          "group": "inline@5"
        },
        {
          "command": "gitWorkspacePro.deleteBranch",
          "when": "view == gitWorkspacePro.repositories && viewItem == repository",
          "group": "inline@6"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest:unit": "tsc -p ./tsconfig.test.json",
    "test:unit": "mocha",
    "test": "npm run compile && npm run lint && npm run test:unit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.57.0",
    "glob": "^10.5.0",
    "mocha": "^11.8.0",
    "typescript": "^5.5.4"
  }
}
