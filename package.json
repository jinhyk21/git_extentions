{
  "name": "git-workspace-pro",
  "displayName": "Git Workspace Pro",
  "description": "%extension.description%",
  "version": "0.4.0",
  "author": "Ninh Ngọc Tuấn",
  "publisher": "jinhy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinhyk21/git_extentions"
  },
  "bugs": {
    "url": "https://github.com/jinhyk21/git_extentions/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "multi-repo",
    "monorepo",
    "merge conflict",
    "source control"
  ],
  "icon": "media/logo.png",
  "main": "./dist/extension/activate.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitWorkspacePro",
          "title": "Git Workspace Pro",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "gitWorkspacePro": [
        {
          "id": "gitWorkspacePro.dashboard",
          "name": "%view.repositories%",
          "type": "webview",
          "when": "config.gitWorkspacePro.sidebar.mode != 'classic'"
        },
        {
          "id": "gitWorkspacePro.repositories",
          "name": "%view.repositories%",
          "when": "config.gitWorkspacePro.sidebar.mode == 'classic'"
        }
      ]
    },
    "commands": [
      {
        "command": "gitWorkspacePro.refreshRepositories",
        "title": "%command.refreshRepositories%",
        "icon": "$(refresh)"
      },
      {
        "command": "gitWorkspacePro.openChangedFile",
        "title": "%command.openChangedFile%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitWorkspacePro.stageFile",
        "title": "%command.stageFile%",
        "icon": "$(add)"
      },
      {
        "command": "gitWorkspacePro.unstageFile",
        "title": "%command.unstageFile%",
        "icon": "$(remove)"
      },
      {
        "command": "gitWorkspacePro.openDiff",
        "title": "%command.openDiff%",
        "icon": "$(diff)"
      },
      {
        "command": "gitWorkspacePro.resolveConflict",
        "title": "%command.resolveConflict%",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitWorkspacePro.discardFile",
        "title": "%command.discardFile%",
        "icon": "$(discard)"
      },
      {
        "command": "gitWorkspacePro.stageAll",
        "title": "%command.stageAll%",
        "icon": "$(add)"
      },
      {
        "command": "gitWorkspacePro.unstageAll",
        "title": "%command.unstageAll%",
        "icon": "$(remove)"
      },
      {
        "command": "gitWorkspacePro.restoreAll",
        "title": "%command.restoreAll%",
        "icon": "$(discard)"
      },
      {
        "command": "gitWorkspacePro.commit",
        "title": "%command.commit%",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitWorkspacePro.fetch",
        "title": "%command.fetch%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitWorkspacePro.pull",
        "title": "%command.pull%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitWorkspacePro.pullBranch",
        "title": "%command.pullBranch%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitWorkspacePro.push",
        "title": "%command.push%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitWorkspacePro.checkoutBranch",
        "title": "%command.checkoutBranch%",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitWorkspacePro.createBranch",
        "title": "%command.createBranch%",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "gitWorkspacePro.deleteBranch",
        "title": "%command.deleteBranch%",
        "icon": "$(trash)"
      },
      {
        "command": "gitWorkspacePro.mergeBranch",
        "title": "%command.mergeBranch%",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitWorkspacePro.rebaseBranch",
        "title": "%command.rebaseBranch%",
        "icon": "$(repo-force-push)"
      },
      {
        "command": "gitWorkspacePro.stashPush",
        "title": "%command.stashPush%",
        "icon": "$(archive)"
      },
      {
        "command": "gitWorkspacePro.stashPop",
        "title": "%command.stashPop%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "gitWorkspacePro.continueOperation",
        "title": "%command.continueOperation%",
        "icon": "$(debug-continue)"
      },
      {
        "command": "gitWorkspacePro.abortOperation",
        "title": "%command.abortOperation%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "gitWorkspacePro.skipOperation",
        "title": "%command.skipOperation%",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "gitWorkspacePro.showRepositoryActions",
        "title": "%command.showRepositoryActions%",
        "icon": "$(ellipsis)"
      },
      {
        "command": "gitWorkspacePro.showHistory",
        "title": "%command.showHistory%",
        "icon": "$(history)"
      },
      {
        "command": "gitWorkspacePro.runCustomCommand",
        "title": "%command.runCustomCommand%",
        "icon": "$(terminal)"
      },
      {
        "command": "gitWorkspacePro.fetchAll",
        "title": "%command.fetchAll%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitWorkspacePro.quickActions",
        "title": "%command.quickActions%",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitWorkspacePro.focusSearch",
        "title": "%command.focusSearch%",
        "icon": "$(search)"
      },
      {
        "command": "gitWorkspacePro.commitWithMessage",
        "title": "%command.commitWithMessage%"
      },
      {
        "command": "gitWorkspacePro.changeLanguage",
        "title": "%command.changeLanguage%",
        "icon": "$(globe)"
      }
    ],
    "configuration": {
      "title": "Git Workspace Pro",
      "properties": {
        "gitWorkspacePro.language": {
          "type": "string",
          "enum": [
            "auto",
            "vi",
            "en",
            "zh-cn"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.vi%",
            "%config.language.en%",
            "%config.language.zh-cn%"
          ],
          "default": "auto",
          "markdownDescription": "%config.language.description%"
        },
        "gitWorkspacePro.sidebar.mode": {
          "type": "string",
          "enum": ["modern", "classic"],
          "enumDescriptions": [
            "%config.sidebar.mode.modern%",
            "%config.sidebar.mode.classic%"
          ],
          "default": "modern",
          "description": "%config.sidebar.mode%"
        },
        "gitWorkspacePro.sidebar.showCleanRepositories": {
          "type": "boolean",
          "default": false,
          "description": "%config.sidebar.showCleanRepositories%"
        },
        "gitWorkspacePro.pullStrategy": {
          "type": "string",
          "enum": [
            "ask",
            "ff-only",
            "rebase",
            "merge"
          ],
          "enumDescriptions": [
            "%config.pullStrategy.ask%",
            "%config.pullStrategy.ff-only%",
            "%config.pullStrategy.rebase%",
            "%config.pullStrategy.merge%"
          ],
          "default": "ask",
          "description": "%config.pullStrategy.description%"
        },
        "gitWorkspacePro.history.maxCount": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 5000,
          "description": "%config.history.maxCount%"
        },
        "gitWorkspacePro.scan.excludeDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.scan.excludeDirectories%"
        },
        "gitWorkspacePro.scan.maxDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.scan.maxDepth%"
        },
        "gitWorkspacePro.customCommand.historySize": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 200,
          "description": "%config.customCommand.historySize%"
        },
        "gitWorkspacePro.customCommand.shell": {
          "type": "string",
          "default": "",
          "description": "%config.customCommand.shell%"
        },
        "gitWorkspacePro.customCommand.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%config.customCommand.autoRefresh%"
        },
        "gitWorkspacePro.customCommand.timeoutSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.customCommand.timeoutSeconds%"
        }
      }
    },
    "keybindings": [
      {
        "command": "gitWorkspacePro.quickActions",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "gitWorkspacePro.focusSearch",
        "key": "ctrl+alt+shift+g",
        "mac": "cmd+alt+shift+g"
      },
      {
        "command": "gitWorkspacePro.fetchAll",
        "key": "ctrl+alt+g f",
        "mac": "cmd+alt+g f"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "gitWorkspacePro.openChangedFile",
          "when": "view == gitWorkspacePro.repositories && viewItem =~ /changedFile/",
          "group": "inline@1"
        },
        {
          "command": "gitWorkspacePro.openDiff",
          "when": "view == gitWorkspacePro.repositories && viewItem =~ /changedFile/ && viewItem != changedFile.conflicted",
          "group": "inline@2"
        },
        {
          "command": "gitWorkspacePro.resolveConflict",
          "when": "view == gitWorkspacePro.repositories && viewItem == changedFile.conflicted",
          "group": "inline@2"
        },
        {
          "command": "gitWorkspacePro.stageFile",
          "when": "view == gitWorkspacePro.repositories && (viewItem == changedFile.unstaged || viewItem == changedFile.untracked)",
          "group": "inline@3"
        },
        {
          "command": "gitWorkspacePro.unstageFile",
          "when": "view == gitWorkspacePro.repositories && viewItem == changedFile.staged",
          "group": "inline@4"
        },
        {
          "command": "gitWorkspacePro.discardFile",
          "when": "view == gitWorkspacePro.repositories && (viewItem == changedFile.unstaged || viewItem == changedFile.untracked)",
          "group": "inline@5"
        },
        {
          "command": "gitWorkspacePro.refreshRepositories",
          "when": "view == gitWorkspacePro.repositories && viewItem == repository",
          "group": "inline@4"
        },
        {
          "command": "gitWorkspacePro.showRepositoryActions",
          "when": "view == gitWorkspacePro.repositories && viewItem == repository",
          "group": "navigation@1"
        },
        {
          "command": "gitWorkspacePro.restoreAll",
          "when": "view == gitWorkspacePro.repositories && viewItem == repository",
          "group": "inline@5"
        },
        {
          "command": "gitWorkspacePro.deleteBranch",
          "when": "view == gitWorkspacePro.repositories && viewItem == repository",
          "group": "inline@6"
        },
        {
          "command": "gitWorkspacePro.showHistory",
          "when": "view == gitWorkspacePro.repositories && viewItem == repository",
          "group": "inline@7"
        },
        {
          "command": "gitWorkspacePro.runCustomCommand",
          "when": "view == gitWorkspacePro.repositories && viewItem == repository",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "gitWorkspacePro.fetchAll",
          "when": "view == gitWorkspacePro.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "gitWorkspacePro.refreshRepositories",
          "when": "view == gitWorkspacePro.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "gitWorkspacePro.refreshRepositories",
          "when": "view == gitWorkspacePro.repositories",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitWorkspacePro.openChangedFile",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.stageFile",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.unstageFile",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.openDiff",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.resolveConflict",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.discardFile",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.stageAll",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.unstageAll",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.restoreAll",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.commit",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.fetch",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.pull",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.pullBranch",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.push",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.checkoutBranch",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.createBranch",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.deleteBranch",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.mergeBranch",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.rebaseBranch",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.stashPush",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.stashPop",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.showHistory",
          "when": "false"
        },
        {
          "command": "gitWorkspacePro.commitWithMessage",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest:unit": "tsc -p ./tsconfig.test.json",
    "test:unit": "mocha",
    "test": "npm run compile && npm run lint && npm run test:unit",
    "test:vscode": "npm run compile && npm run pretest:unit && node out-test/test/vscode/runTest.js",
    "qa:smoke": "npm test",
    "qa:ui": "npm run pretest:unit && mocha --grep \"\\\\[UI/UX\\\\]\" && node scripts/qa-render-ui.js && node scripts/qa-render-sidebar.js",
    "qa:performance": "npm run compile && node scripts/qa-performance.js",
    "qa:all": "npm run qa:smoke && npm run qa:ui && npm run qa:performance",
    "qa:create-conflict": "node scripts/create-conflict-fixture.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.57.0",
    "glob": "^10.5.0",
    "mocha": "^11.8.0",
    "typescript": "^5.5.4"
  }
}
